# buzz-deployer.service — out-of-band release executor for the private Buzz box.
#
# Modelled on buzz-backup-latest.service (oneshot, ConditionPathExists guards,
# UMask=0077, Nice, ProtectSystem=strict with a narrow ReadWritePaths) and it
# differs from that unit in exactly one way that matters: it runs as root.
#
# WHY ROOT, AND WHAT THAT BUYS
#
#   /opt/buzz/bin/buzz-acp is root-owned 0755 precisely so that the hermes-run
#   agents cannot rewrite the binary they are about to execute. Something has to
#   be able to replace it, and that something is this unit. It also needs to
#   `systemctl restart` the relay and agent units and to talk to the docker
#   socket. There is no useful subset of those capabilities: any principal that
#   can replace buzz-acp and restart the services running it already owns the
#   box, so a partially-privileged deployer would be security theatre with
#   worse ergonomics.
#
#   The real containment is elsewhere, and it is deliberate:
#     * ProtectSystem=strict makes the entire filesystem read-only except the
#       four paths below. Root here cannot write /etc, /usr, or a home dir.
#     * The install destinations are hard-coded in deploy.sh, never read from a
#       manifest. A release cannot choose which file root overwrites.
#     * Artifacts are hash-verified against the manifest before install, and
#       the manifest's source_commit must equal the build repo's HEAD.
#     * No network fetch, ever. Everything must already be on the box.
#     * The trigger is a directory drop, not an RPC. The attack surface is
#       "who can write /opt/buzz/releases/incoming", which is a filesystem
#       permission you can read off `ls -ld` rather than a protocol you have to
#       reason about.
#
# WHY ONESHOT AND NOT A DAEMON
#
#   A deploy is an event with an end. A long-lived deployer would have to be
#   restarted to pick up its own updates — the exact recursion this component
#   exists to avoid. Oneshot means the executor is never the thing being
#   replaced while it is running.
#
# Triggered by buzz-deployer.path. Can also be run by hand:
#     sudo systemctl start buzz-deployer.service
#
[Unit]
Description=Buzz self-hosted release executor (out-of-band deployer)
Documentation=file:/opt/buzz/scripts/selfhost/deploy.sh
Documentation=file:/opt/buzz/src/docs/selfhost-releases.md
Requires=docker.service
After=docker.service buzz-relay.service network-online.target

# Refuse to start into a shape this runbook does not describe. A deployer that
# starts anyway and discovers the problem halfway through a swap is worse than
# one that never started: ConditionPathExists failures are logged and inert.
ConditionPathExists=/opt/buzz/scripts/selfhost/deploy.sh
ConditionPathExists=/opt/buzz/relay/compose.yml
ConditionPathExists=/opt/buzz/relay/.env
ConditionPathExists=/opt/buzz/bin

[Service]
Type=oneshot
# Root: see the header. Not negotiable for the bin swap and the unit restarts.
User=root
Group=root
UMask=0077

# Optional. Holds the deployer's OWN nostr identity for --announce-root:
#   BUZZ_RELAY_URL=https://hermes.tail81f3.ts.net:9443
#   BUZZ_PRIVATE_KEY=<the deployer's key, never an agent's>
#   BUZZ_ANNOUNCE_REPO_OWNER=<64-hex>
#   BUZZ_ANNOUNCE_REPO_ID=<repo d-tag>
#   BUZZ_ANNOUNCE_ROOT=<64-hex issue or PR root event>
# The leading '-' makes the file optional: announcing is a convenience, and a
# missing key must never be the reason a release does not ship.
EnvironmentFile=-/opt/buzz/agents/deployer.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GIT_OPTIONAL_LOCKS=0
Environment=BUZZ_DEPLOY_REPO=/opt/buzz/src

# --execute is spelled out here and nowhere else. Everywhere a human types this
# command it defaults to a dry run; the one place it deploys is a unit file that
# needs root to install.
ExecStart=/opt/buzz/scripts/selfhost/deploy.sh --execute --inbox /opt/buzz/releases

# Generous but bounded. The worst legitimate case is a schema-bearing release:
# a postgres-inclusive backup, a relay recreate, and two 60s agent gates.
TimeoutStartSec=45min

# A release is never urgent enough to starve the relay it is deploying.
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5

# Containment. ProtectSystem=strict + an explicit allow-list is the whole
# point: root, but root that can only write the four places a deploy touches.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/buzz/bin /opt/buzz/relay /opt/buzz/backups /opt/buzz/releases
PrivateTmp=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# NOT set, and each omission is a decision:
#   NoNewPrivileges  — deploy.sh shells out to docker and systemctl; leave the
#                      default rather than discover the interaction at 3am.
#   ProtectControlGroups / PrivateDevices — docker compose needs them.
#   CapabilityBoundingSet= — emptying it would break chown on the installed
#                      binaries, which is the job.

[Install]
# Deliberately no WantedBy. This unit is triggered by buzz-deployer.path or by
# hand; enabling it to run at boot would mean a box that reboots mid-incident
# comes up and immediately deploys whatever was in the inbox.
